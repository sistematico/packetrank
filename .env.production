# ID da aplicação Discord (Developer Portal → General Information → Application ID)
DISCORD_APP_ID=

# Token do bot (Developer Portal → Bot → Token)
DISCORD_TOKEN=

# (Opcional) ID do servidor para registro instantâneo de slash commands durante o desenvolvimento.
# Se omitido, os comandos são registrados globalmente (pode levar até 1 h).
DISCORD_GUILD_ID=

# Token de autenticação para a API do site packetloss.com.br (se necessário)
API_TOKEN=

# URL base da API do site packetloss.com.br
# Em desenvolvimento pode ser http://localhost:3000
API_BASE_URL=https://packetloss.com.br

# Use "true" para forçar dados de mockup mesmo com API_BASE_URL definida
USE_MOCK_API=false

# (Opcional) ID de cargo permitido para usar comandos administrativos do bot
ALLOWED_ROLE_ID=

# (Opcional) IDs de usuário Discord com permissão total (separados por vírgula)
ALLOWED_USER_IDS=SEU_DISCORD_ID
