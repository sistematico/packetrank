{
  "name": "packetrank",
  "version": "1.0.2",
  "author": "sistematico",
  "description": "Bot Discord para o site packetloss.com.br — exibe partidas, ranks e rankings",
  "keywords": ["discordjs", "bot", "discord", "javascript", "typescript"],
  "license": "ISC",
  "main": "dist/bot.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bot.ts",
